{
  "compilerOptions": {
    "module": "node16",
    "moduleResolution": "node16",
    "target": "es2022",
    "lib": [
      "es2022"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true
  },
  "include": [
    "main.ts",
    "variables.ts",
    "bootstrap/**/*.ts",
    "modules/**/*.ts",
    "stacks/**/*.ts",
    "local/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "cdktn.out"
  ]
}
