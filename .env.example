# Copy to .env and adjust as needed: cp .env.example .env

# Postgres (used by docker-compose.yml)
POSTGRES_USER=petfinder
POSTGRES_PASSWORD=petfinder
POSTGRES_DB=petfinder
POSTGRES_PORT=5432

# Connection string for the api
DATABASE_URL=postgresql://petfinder:petfinder@localhost:5432/petfinder

# Apply pending migrations when the api starts (local dev only)
DB_RUN_MIGRATIONS=true

# Database used by `nx test-integration api` (created automatically)
TEST_DATABASE_URL=postgresql://petfinder:petfinder@localhost:5432/petfinder_test
