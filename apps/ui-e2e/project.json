{
  "name": "ui-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/ui-e2e/src",
  "implicitDependencies": [
    "ui"
  ],
  "// targets": "to see all targets run: nx show project ui-e2e --web",
  "targets": {
    "bddgen": {
      "command": "bddgen",
      "options": {
        "cwd": "apps/ui-e2e"
      },
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/playwright.config.mts"
      ],
      "outputs": [
        "{projectRoot}/.features-gen"
      ],
      "cache": true
    },
    "e2e": {
      "dependsOn": [
        "bddgen",
        {
          "projects": [
            "ui"
          ],
          "target": "serve",
          "waitFor": "ready"
        }
      ]
    }
  }
}
